shaders = 8

LumaTrapDepth = 0.0

//======== Simulate NTSC composite video.
shader0 = shaders/analog/to_yuv.slang
filter_linear0 = false
mipmap_input0 = false
scale_type0 = source
scale0 = 1.0

shader1 = shaders/analog/ntsc_encode_filter.slang
filter_linear1 = false
mipmap_input1 = false
scale_type_x1 = absolute
scale_x1 = 900
scale_type_y1 = source
scale_y1 = 1.0

shader2 = shaders/analog/ntsc_encode.slang
filter_linear2 = false
wrap_mode2 = clamp_to_border
mipmap_input2 = false
scale_type2 = source
scale2 = 1.0

shader3 = shaders/analog/ntsc_decode_filter.slang
filter_linear3 = false
wrap_mode3 = clamp_to_border
mipmap_input3 = false
scale_type3 = source
scale3 = 1.0

shader4 = shaders/analog/ntsc_decode_comb.slang
filter_linear4 = false
wrap_mode4 = clamp_to_border
mipmap_input4 = false
scale_type4 = source
scale4 = 1.0

shader5 = shaders/analog/ntsc_decode_chroma_filter.slang
alias5 = Linearized
filter_linear5 = false
wrap_mode5 = clamp_to_border
mipmap_input5 = false
scale_type5 = source
scale5 = 1.0

//======== Draw the scanlines, handling interlacing and overscan.
shader6 = shaders/scanline_horizontal.slang
filter_linear6 = false
wrap_mode6 = clamp_to_border
mipmap_input6 = false
scale_type_x6 = viewport
scale_x6 = 1.0
scale_type_y6 = source
scale_y6 = 1.0

shader7 = shaders/scanline_vertical_output.slang
filter_linear7 = false
wrap_mode7 = clamp_to_border
mipmap_input7 = false
