shaders = 15

LumaTrapDepth = 0.0

textures = BlueNoiseTex

// Blue noise texture from https://github.com/Calinou/free-blue-noise-textures
// (Licensed CC0)
// This is used for dithering.
// It is expected (in composite_output.slang) that this texture is 64x64. Using
// a different size will require changes to that file.
BlueNoiseTex = shaders/blue_noise.png
BlueNoiseTex_wrap_mode = repeat
BlueNoiseTex_linear = true
BlueNoiseTex_mipmap = false

//======== Simulate NTSC composite video.
shader0 = shaders/analog/to_yuv.slang
filter_linear0 = false
mipmap_input0 = false
scale_type0 = source
scale0 = 1.0

shader1 = shaders/analog/ntsc_encode.slang
filter_linear1 = false
mipmap_input1 = false
scale_type_x1 = absolute
scale_x1 = 900
scale_type_y1 = source
scale_y1 = 1.0

shader2 = shaders/analog/ntsc_decode_filter.slang
filter_linear2 = false
wrap_mode2 = clamp_to_border
mipmap_input2 = false
scale_type2 = source
scale2 = 1.0

shader3 = shaders/analog/ntsc_decode_comb.slang
filter_linear3 = false
wrap_mode3 = clamp_to_border
mipmap_input3 = false
scale_type3 = source
scale3 = 1.0

shader4 = shaders/analog/ntsc_decode_chroma_filter.slang
alias4 = Linearized
filter_linear4 = false
wrap_mode4 = clamp_to_border
mipmap_input4 = false
scale_type4 = source
scale4 = 1.0

//======== Draw the scanlines, handling interlacing and overscan.
shader5 = shaders/scanline_horizontal.slang
filter_linear5 = false
wrap_mode5 = clamp_to_border
mipmap_input5 = false
scale_type_x5 = viewport
scale_x5 = 1.0
scale_type_y5 = source
scale_y5 = 1.0

shader6 = shaders/scanline_vertical.slang
alias6 = Scanlines
filter_linear6 = false
wrap_mode6 = clamp_to_border
mipmap_input6 = false
scale_type6 = viewport
scale6 = 1.0

//======== Downscale 3 times (to ~1/8 size per dimension) for glow blurring.
// Downscale and perform the blur on a smaller texture for performance.
// Use a 4x4 cubic downscale to minimize aliasing and shimmering in the blur.
shader7 = shaders/cubic_downsample.slang
filter_linear7 = true
wrap_mode7 = clamp_to_border
mipmap_input7 = false
scale_type7 = source
scale7 = 0.5

shader8 = shaders/cubic_downsample.slang
filter_linear8 = true
wrap_mode8 = clamp_to_border
mipmap_input8 = false
scale_type8 = source
scale8 = 0.5

shader9 = shaders/cubic_downsample.slang
filter_linear9 = true
wrap_mode9 = clamp_to_border
mipmap_input9 = false
scale_type9 = source
scale9 = 0.5

//======== Blur for the glow: first pass horizontal, second pass vertical.
shader10 = shaders/blur_horizontal.slang
filter_linear10 = true
wrap_mode10 = clamp_to_border
mipmap_input10 = false
scale_type10 = source
scale10 = 1.0

shader11 = shaders/blur_vertical.slang
filter_linear11 = true
wrap_mode11 = clamp_to_border
mipmap_input11 = false
scale_type11 = source
scale11 = 1.0

//======== Upscale the blurred texture.
// Repeated bilinear upscales blur the texture a bit more, which is noticeable
// with small blur sigmas. However, here are no blocky artifacts like we would
// get if we upscaled straight to the viewport size. The final upscale happens
// in the composite pass.
shader12 = shaders/bilinear_upsample.slang
filter_linear12 = true
wrap_mode12 = clamp_to_border
mipmap_input12 = false
scale_type12 = source
scale12 = 2.0

shader13 = shaders/bilinear_upsample.slang
filter_linear13 = true
wrap_mode13 = clamp_to_border
mipmap_input13 = false
scale_type13 = source
scale13 = 2.0

//======== Composite the blur on the image, then convert to sRGB.
shader14 = shaders/composite_output.slang
filter_linear14 = true
wrap_mode14 = clamp_to_border
mipmap_input14 = false
